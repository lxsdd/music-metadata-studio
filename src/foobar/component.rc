#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDR_DEFAULT_RULESET RCDATA "../../rules/default-rules.json"

IDD_MENU_PREFERENCES DIALOGEX 0, 0, 485, 194
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Metadata preview:", -1, 12, 17, 105, 12
    EDITTEXT        IDC_CAPTION_METADATA, 122, 13, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Singles preview:", -1, 12, 47, 105, 12
    EDITTEXT        IDC_CAPTION_SINGLES, 122, 43, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Albums preview:", -1, 12, 77, 105, 12
    EDITTEXT        IDC_CAPTION_ALBEN, 122, 73, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Live Sets preview:", -1, 12, 107, 105, 12
    EDITTEXT        IDC_CAPTION_LIVESETS, 122, 103, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Prepare Tracks:", -1, 12, 137, 105, 12
    EDITTEXT        IDC_CAPTION_PREPARE, 122, 133, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Show/hide: Display > Context Menu.", -1, 12, 163, 464, 12
    LTEXT           "Apply saves. Cancel discards. Reset restores defaults.", -1, 12, 179, 464, 12
END

IDD_BATCH_PREVIEW DIALOGEX 0, 0, 560, 396
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Prepare Tracks - Batch Preview (No Writes)"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_BATCH_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 9, 540, 28
    LTEXT           "Show:", IDC_METADATA_FILTER_LABEL, 10, 40, 40, 12
    COMBOBOX        IDC_METADATA_FILTER, 54, 37, 126, 82, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tracks:", IDC_METADATA_TRACK_FILTER_LABEL, 190, 40, 42, 12
    COMBOBOX        IDC_METADATA_TRACK_FILTER, 236, 37, 150, 82, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Show whitespace", IDC_METADATA_VISIBLE_WHITESPACE, 400, 39, 148, 14, WS_TABSTOP
    CONTROL         "", IDC_METADATA_TRACK_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 10, 59, 220, 262
    CONTROL         "", IDC_METADATA_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 236, 59, 314, 262
    CONTROL         "", IDC_BATCH_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 10, 39, 540, 210
    LTEXT           "Routing profile:", IDC_BATCH_ROUTE_LABEL, 10, 260, 82, 12
    COMBOBOX        IDC_BATCH_PROFILE_PICKER, 96, 258, 454, 95, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Destination:", IDC_BATCH_DEST_LABEL, 10, 287, 82, 12
    EDITTEXT        IDC_BATCH_DESTINATION, 96, 285, 454, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Naming expression:", IDC_BATCH_PATTERN_LABEL, 10, 313, 82, 12
    EDITTEXT        IDC_BATCH_PATTERN, 96, 311, 454, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Metadata proposals are read-only. Select File locations to edit routing; nothing is written.", IDC_BATCH_HINT, 10, 335, 540, 14
    COMBOBOX        IDC_METADATA_REVIEW_SCOPE, 10, 361, 110, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Accept", IDC_METADATA_ACCEPT, 124, 363, 57, 19, WS_TABSTOP
    PUSHBUTTON      "Reject", IDC_METADATA_REJECT, 184, 363, 57, 19, WS_TABSTOP
    PUSHBUTTON      "Reset", IDC_METADATA_RESET, 244, 363, 57, 19, WS_TABSTOP
    EDITTEXT        IDC_METADATA_MANUAL_INPUT, 305, 365, 105, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Use value", IDC_METADATA_USE_VALUE, 416, 363, 63, 19, WS_TABSTOP
    PUSHBUTTON      "Preview selected", IDC_BATCH_APPLY_SELECTED, 309, 363, 83, 19
    PUSHBUTTON      "Preview all", IDC_BATCH_APPLY_ALL, 397, 363, 82, 19
    DEFPUSHBUTTON   "Close", IDCANCEL, 485, 363, 65, 19
END

IDD_PRECISION_CUE_PREVIEW DIALOGEX 0, 0, 560, 380
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Precision CUE - Preview / External CUE Create"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Apple/Deezer URL or album:", -1, 10, 12, 137, 12
    EDITTEXT        IDC_PRECISION_APPLE_LINK, 148, 9, 309, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Search albums", IDC_PRECISION_SEARCH, 464, 9, 86, 18, WS_TABSTOP
    LTEXT           "Apple duration candidate:", -1, 10, 35, 137, 12
    COMBOBOX        IDC_PRECISION_ALBUM_RESULTS, 148, 32, 309, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Look up selected", IDC_PRECISION_LOOKUP, 464, 32, 86, 18, WS_TABSTOP
    LTEXT           "Preview changes nothing. A new external .cue is created only after separate confirmation.", IDC_PRECISION_SOURCE_HINT, 10, 59, 445, 20
    PUSHBUTTON      "Cancel lookup", IDC_PRECISION_CANCEL_LOOKUP, 464, 57, 86, 20, WS_TABSTOP | WS_DISABLED
    LTEXT           "Disc:", -1, 10, 85, 35, 12
    COMBOBOX        IDC_PRECISION_DISC_PICKER, 48, 82, 98, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "MP3:", -1, 156, 85, 35, 12
    COMBOBOX        IDC_PRECISION_MP3_PICKER, 191, 82, 213, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Assign disc", IDC_PRECISION_ASSIGN_DISC, 413, 82, 137, 18, WS_TABSTOP
    PUSHBUTTON      "Preview reviewed mapping", IDC_PRECISION_PREVIEW_ASSIGNED, 10, 109, 175, 18, WS_TABSTOP
    LTEXT           "Each disc must be assigned explicitly; previews never authorize writes.", -1, 198, 112, 352, 14
    EDITTEXT        IDC_PRECISION_PREVIEW_TEXT, 10, 135, 540, 157, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_HSCROLL | ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "I verified the exact mix / edition", IDC_PRECISION_EDITION_CONFIRMED, 10, 300, 249, 18, WS_TABSTOP
    PUSHBUTTON      "Copy selected disc CUE", IDC_PRECISION_COPY_CUE, 270, 301, 243, 18, WS_TABSTOP | WS_DISABLED
    PUSHBUTTON      "Create selected .cue", IDC_PRECISION_SAVE_CUE, 270, 324, 243, 18, WS_TABSTOP | WS_DISABLED
    PUSHBUTTON      "Create all reviewed .cues", IDC_PRECISION_SAVE_ALL_CUES, 270, 348, 193, 18, WS_TABSTOP | WS_DISABLED
    PUSHBUTTON      "Close", IDCANCEL, 479, 348, 71, 18, WS_TABSTOP
END
