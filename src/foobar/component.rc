#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDR_DEFAULT_RULESET RCDATA "../../rules/default-rules.json"

IDD_MENU_PREFERENCES DIALOGEX 0, 0, 485, 194
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Metadata preview:", -1, 12, 17, 105, 12
    EDITTEXT        IDC_CAPTION_METADATA, 122, 13, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Singles preview:", -1, 12, 47, 105, 12
    EDITTEXT        IDC_CAPTION_SINGLES, 122, 43, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Albums preview:", -1, 12, 77, 105, 12
    EDITTEXT        IDC_CAPTION_ALBEN, 122, 73, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Live Sets preview:", -1, 12, 107, 105, 12
    EDITTEXT        IDC_CAPTION_LIVESETS, 122, 103, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Prepare Tracks:", -1, 12, 137, 105, 12
    EDITTEXT        IDC_CAPTION_PREPARE, 122, 133, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Show/hide: Display > Context Menu.", -1, 12, 163, 464, 12
    LTEXT           "Apply saves. Cancel discards. Reset restores defaults.", -1, 12, 179, 464, 12
END

IDD_BATCH_PREVIEW DIALOGEX 0, 0, 560, 396
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW
CAPTION "Music Metadata Studio - Prepare Tracks (Read-only)"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_BATCH_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 9, 540, 28
    LTEXT           "Choose a track, then search for metadata. Nothing is applied automatically.", IDC_BATCH_GUIDE, 17, 28, 526, 9
    LTEXT           "Show:", IDC_METADATA_FILTER_LABEL, 10, 40, 40, 12
    COMBOBOX        IDC_METADATA_FILTER, 54, 37, 126, 82, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tracks:", IDC_METADATA_TRACK_FILTER_LABEL, 190, 40, 42, 12
    COMBOBOX        IDC_METADATA_TRACK_FILTER, 236, 37, 150, 82, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Show whitespace", IDC_METADATA_VISIBLE_WHITESPACE, 400, 39, 148, 14, WS_TABSTOP
    COMBOBOX        IDC_METADATA_ONLINE_PROVIDER, 10, 38, 152, 64, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Discogs token:", IDC_METADATA_DISCOGS_TOKEN_LABEL, 173, 41, 75, 12
    EDITTEXT        IDC_METADATA_DISCOGS_TOKEN, 253, 38, 297, 17, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        IDC_METADATA_MB_QUERY, 10, 59, 185, 17, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Search MusicBrainz", IDC_METADATA_MB_SEARCH, 202, 59, 108, 17, WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "Inspect CUE", IDC_METADATA_INSPECT_CUE, 322, 59, 102, 17, WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "Import clipboard", IDC_METADATA_IMPORT_CANDIDATE, 431, 59, 119, 17, WS_TABSTOP | WS_CLIPSIBLINGS
    CONTROL         "", IDC_METADATA_TRACK_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 10, 80, 220, 241
    CONTROL         "", IDC_METADATA_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 236, 80, 314, 241
    LTEXT           "Selected candidate: field comparison (read-only)", IDC_METADATA_MB_DETAIL_LABEL, 236, 229, 314, 12
    CONTROL         "", IDC_METADATA_MB_DETAILS, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_SHOWSELALWAYS, 236, 243, 314, 78
    CONTROL         "", IDC_BATCH_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 10, 39, 540, 210
    LTEXT           "Routing profile:", IDC_BATCH_ROUTE_LABEL, 10, 260, 82, 12
    COMBOBOX        IDC_BATCH_PROFILE_PICKER, 96, 258, 454, 95, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Destination:", IDC_BATCH_DEST_LABEL, 10, 287, 82, 12
    EDITTEXT        IDC_BATCH_DESTINATION, 96, 285, 454, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Naming expression:", IDC_BATCH_PATTERN_LABEL, 10, 313, 82, 12
    EDITTEXT        IDC_BATCH_PATTERN, 96, 311, 454, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Refresh snapshot", IDC_BATCH_REFRESH, 10, 326, 112, 17, WS_TABSTOP
    PUSHBUTTON      "Help", IDC_BATCH_HELP, 130, 326, 60, 17, WS_TABSTOP
    LTEXT           "Metadata proposals are read-only. No files are changed.", IDC_BATCH_HINT, 10, 345, 540, 18
    COMBOBOX        IDC_METADATA_REVIEW_SCOPE, 10, 367, 110, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Accept", IDC_METADATA_ACCEPT, 124, 369, 57, 19, WS_TABSTOP
    PUSHBUTTON      "Reject", IDC_METADATA_REJECT, 184, 369, 57, 19, WS_TABSTOP
    PUSHBUTTON      "Reset", IDC_METADATA_RESET, 244, 369, 57, 19, WS_TABSTOP
    EDITTEXT        IDC_METADATA_MANUAL_INPUT, 305, 371, 105, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Use value", IDC_METADATA_USE_VALUE, 416, 369, 63, 19, WS_TABSTOP
    PUSHBUTTON      "Inspect release tracks", IDC_METADATA_MB_LOAD_RELEASE, 319, 369, 160, 19, WS_TABSTOP | WS_CLIPSIBLINGS
    LTEXT           "Date target:", IDC_ONLINE_DATE_TARGET_LABEL, 198, 329, 84, 12
    COMBOBOX        IDC_ONLINE_DATE_TARGET, 285, 326, 188, 125, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Include fields (preview)", IDC_ONLINE_INCLUDE_FIELDS, 10, 369, 140, 19, WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "Ignore fields", IDC_ONLINE_IGNORE_FIELDS, 157, 369, 140, 19, WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "Reset online preview", IDC_ONLINE_RESET_FIELDS, 304, 369, 175, 19, WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "Write tags", IDC_ONLINE_WRITE_SELECTED, 482, 326, 68, 17, WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "Next results page", IDC_METADATA_DISCOGS_NEXT_PAGE, 10, 369, 142, 19, WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "Preview selected", IDC_BATCH_APPLY_SELECTED, 309, 369, 83, 19
    PUSHBUTTON      "Preview all", IDC_BATCH_APPLY_ALL, 397, 369, 82, 19
    DEFPUSHBUTTON   "Close", IDCANCEL, 485, 369, 65, 19
END
